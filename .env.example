# ==============================================================================
# CONFIGURACIÓN DE SUPABASE (VARIABLES PÚBLICAS DE CLIENTE)
# ==============================================================================
# Copie este archivo como `.env` para el desarrollo local.
# IMPORTANTE:
# - Utilice ÚNICAMENTE la clave pública `anon` (VITE_SUPABASE_ANON_KEY).
# - NUNCA incluya la clave secreta `service_role` en este archivo, en variables
#   con prefijo VITE_*, ni en el código fuente del frontend.
# ==============================================================================

VITE_SUPABASE_URL=https://su-proyecto-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Nombre del bucket privado configurado en Supabase Storage (por defecto: student-photos)
VITE_SUPABASE_STORAGE_BUCKET=student-photos

# Calidad inicial de compresión JPEG (0.70 a 0.95, recomendado: 0.90)
VITE_DEFAULT_JPEG_QUALITY=0.90

# Habilitar modo de demostración interactiva local cuando Supabase aún no está conectado (true/false)
VITE_ENABLE_DEMO_FALLBACK=true
